#!/usr/bin/env bash
# Copy host Antigravity CLI credentials into a dv container.
#
# agy stores its OAuth token in the host keyring, with a file fallback on
# systems without a keyring (including dv containers). Export on the host;
# the container does not need secret-tool. Keep the destination private.

set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=./hook-env
source "$script_dir/hook-env"

container="${1:-}"
host_auth_file="${AGY_AUTH_FILE:-$HOME/.gemini/antigravity-cli/antigravity-oauth-token}"
container_auth_file="${AGY_CONTAINER_AUTH_FILE:-/home/discourse/.gemini/antigravity-cli/antigravity-oauth-token}"

if [[ -z "$container" ]]; then
  echo "usage: $0 <container>" >&2
  exit 64
fi

auth_tmp_dir=""
cleanup() {
  if [[ -n "$auth_tmp_dir" ]]; then
    rm -rf -- "$auth_tmp_dir"
  fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# An explicitly configured file wins. Otherwise prefer the current keyring
# credential over a possibly stale file left by an older agy installation.
if [[ -z "${AGY_AUTH_FILE:-}" ]] && command -v secret-tool >/dev/null 2>&1; then
  auth_tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/sync-agy-auth.XXXXXXXX")"
  chmod 700 "$auth_tmp_dir"
  if (umask 077; secret-tool lookup service gemini username antigravity > "$auth_tmp_dir/token") &&
      [[ -s "$auth_tmp_dir/token" ]]; then
    host_auth_file="$auth_tmp_dir/token"
    hook_log 'sync-agy-auth: using host keyring (service=gemini, username=antigravity)'
  else
    hook_log 'sync-agy-auth: keyring credential unavailable; trying legacy file'
  fi
fi

if [[ ! -s "$host_auth_file" ]]; then
  echo "sync-agy-auth: no credential available from host keyring or file: $host_auth_file" >&2
  exit 66
fi

if ! docker inspect "$container" >/dev/null 2>&1; then
  echo "sync-agy-auth: container not found: $container" >&2
  exit 69
fi

hook_log "sync-agy-auth: copying $host_auth_file -> $container:$container_auth_file"

docker exec --user root "$container" bash -c \
  'install -d -m 700 -o discourse -g discourse "$(dirname -- "$1")"' \
  bash "$container_auth_file"

docker cp "$host_auth_file" "$container:$container_auth_file"

docker exec --user root "$container" bash -c \
  'chown discourse:discourse "$1" && chmod 600 "$1"' \
  bash "$container_auth_file"

hook_log 'sync-agy-auth: done'
