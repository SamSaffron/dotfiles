#!/usr/bin/env bash

config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
config="$config_home/hypr/quickshell/shell.qml"
mode=$($config_home/hypr/shell-mode status 2>/dev/null || printf current)

if [[ "$mode" == quickshell ]] && command -v qs >/dev/null 2>&1; then
  if qs -p "$config" ipc call shell toggleControlCenter >/dev/null 2>&1; then
    exit 0
  fi
fi

if command -v pavucontrol >/dev/null 2>&1; then
  exec pavucontrol
fi

exec helvum
