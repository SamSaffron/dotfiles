#!/usr/bin/env bash
set -euo pipefail

config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
config="$config_home/hypr/quickshell/shell.qml"
mode=$("$config_home/hypr/shell-mode" status 2>/dev/null || printf current)

if [[ "$mode" != quickshell ]] || ! command -v qs >/dev/null 2>&1; then
  printf 'System Help requires the Quickshell shell. Run: %s/hypr/shell-mode quickshell\n' "$config_home" >&2
  exit 1
fi

exec qs -p "$config" ipc call shell toggleSystemHelp
